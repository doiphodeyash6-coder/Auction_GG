{
  "info": {
    "_postman_id": "c3a4978c-94a7-4a7c-8dad-709ac582182b",
    "name": "Gavel & Grain — Auction REST API",
    "description": "Lab 07: validate registration, JWT sessions, auction endpoints, role protection and bid validation. Set baseUrl to http://localhost:4000. Register a bidder, then use the admin credentials configured in .env for curator requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "bidderToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "auctionId", "value": "" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        { "name": "API and MongoDB status", "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('API is healthy', () => pm.response.to.have.status(200));", "pm.test('MongoDB is connected', () => pm.expect(pm.response.json().database).to.eql('connected')); "] } }] }
      ]
    },
    {
      "name": "Bidder account",
      "item": [
        { "name": "Register bidder", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"Asha Bidder\",\n  \"email\": \"asha@example.com\",\n  \"password\": \"ChangeMe12345\"\n}" }, "url": "{{baseUrl}}/api/auth/register" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Bidder account created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('bidderToken', pm.response.json().token);"] } }] },
        { "name": "Login bidder", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"asha@example.com\",\n  \"password\": \"ChangeMe12345\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login succeeds', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('bidderToken', pm.response.json().token);"] } }] },
        { "name": "Current bidder profile", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{bidderToken}}" }], "url": "{{baseUrl}}/api/auth/me" } },
        { "name": "Login curator (admin)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin login succeeds', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().token);"] } }] }
      ]
    },
    {
      "name": "Auctions",
      "item": [
        { "name": "List auctions", "request": { "method": "GET", "url": "{{baseUrl}}/api/auctions" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Auction list loads', () => pm.response.to.have.status(200));", "const auctions = pm.response.json().auctions || [];", "if (auctions.length) pm.collectionVariables.set('auctionId', auctions[0]._id);"] } }] },
        { "name": "Get auction detail", "request": { "method": "GET", "url": "{{baseUrl}}/api/auctions/{{auctionId}}" } },
        { "name": "Place a bid (bidder JWT)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{bidderToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"amount\": 19000\n}" }, "url": "{{baseUrl}}/api/auctions/{{auctionId}}/bids" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Bid accepted or correctly rejected by current price', () => pm.expect([201, 409]).to.include(pm.response.code));"] } }] },
        { "name": "Create auction (admin only)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Danish teak side table\",\n  \"description\": \"A sturdy teak table with clean joinery and a warm, carefully restored finish.\",\n  \"category\": \"Furniture\",\n  \"imageUrl\": \"/assets/sling-chair.svg\",\n  \"startingPrice\": 12000,\n  \"minIncrement\": 500,\n  \"durationHours\": 48\n}" }, "url": "{{baseUrl}}/api/auctions" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Curator can publish a lot', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('auctionId', pm.response.json().auction._id);"] } }] },
        { "name": "Close auction (admin only)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/auctions/{{auctionId}}/close" } }
      ]
    },
    {
      "name": "Expected security checks",
      "item": [
        { "name": "Bid without JWT (expect 401)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"amount\": 50000\n}" }, "url": "{{baseUrl}}/api/auctions/{{auctionId}}/bids" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Unauthenticated bid is rejected', () => pm.response.to.have.status(401));"] } }] },
        { "name": "Create auction as bidder (expect 403)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{bidderToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Not allowed lot\",\n  \"description\": \"This bidder account should not be allowed to publish lots.\",\n  \"category\": \"Furniture\",\n  \"startingPrice\": 1000\n}" }, "url": "{{baseUrl}}/api/auctions" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Bidder cannot publish lots', () => pm.response.to.have.status(403));"] } }] }
      ]
    }
  ]
}
