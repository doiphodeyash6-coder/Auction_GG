NODE_ENV=development
PORT=4000
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173,http://localhost:4000

# Optional: creates or promotes this account to the admin role at startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Optional transactional email via Resend. Use a sender on a verified domain for production.
RESEND_API_KEY=
EMAIL_FROM=Gavel & Grain <auctions@your-verified-domain.com>

# For a separate Vercel frontend, set this to the deployed API origin.
# VITE_API_URL=https://your-api.onrender.com
# VITE_SOCKET_URL=https://your-api.onrender.com
